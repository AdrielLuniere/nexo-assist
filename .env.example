# Copie para .env (`cp .env.example .env`). Nunca versione o .env.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3333

# Banco: casa com o docker-compose.yml (credenciais apenas para desenvolvimento local).
DATABASE_URL=postgresql://nexo:nexo@127.0.0.1:5434/nexo_assist

# Tempo máximo (ms) da checagem de banco no /health.
HEALTH_DB_TIMEOUT_MS=2000

# Segredo que assina os tokens de sessão (mínimo 32 caracteres). Obrigatório em produção.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, em desenvolvimento a API usa um segredo efêmero (as sessões caem a cada reinício).
# AUTH_SECRET=

# Duração da sessão demonstrativa, em minutos (padrão 480).
# AUTH_SESSION_TTL_MINUTES=480

# Agente: modelo no formato `provedor/modelo` do model router do Mastra e a chave do provedor.
# Sem AGENT_MODEL a API funciona, mas o agente não responde (a mensagem fica pendente; AGENT_UNAVAILABLE).
# Nunca versione chaves reais.
# AGENT_MODEL=anthropic/claude-haiku-5-5
# ANTHROPIC_API_KEY=
# (outro provedor, ex.: AGENT_MODEL=openai/gpt-5-mini com OPENAI_API_KEY=)

# Tempo máximo de uma resposta do agente (ms) e respostas simultâneas por processo.
# AGENT_TIMEOUT_MS=45000
# AGENT_MAX_CONCURRENCY=4

# Avaliação opcional com o modelo real (`npm run test:live`, custa tokens).
# AGENT_LIVE_TEST=1
