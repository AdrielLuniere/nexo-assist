# Copie para .env (`cp .env.example .env`). Nunca versione o .env.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3333

# Banco: casa com o docker-compose.yml (credenciais apenas para desenvolvimento local).
DATABASE_URL=postgresql://nexo:nexo@127.0.0.1:5434/nexo_assist

# Tempo máximo (ms) da checagem de banco no /health.
HEALTH_DB_TIMEOUT_MS=2000

# Segredo que assina os tokens de sessão (mínimo 32 caracteres). Obrigatório em produção.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, em desenvolvimento a API usa um segredo efêmero (as sessões caem a cada reinício).
# AUTH_SECRET=

# Duração da sessão demonstrativa, em minutos (padrão 480).
# AUTH_SESSION_TTL_MINUTES=480

# Modelo do agente no formato `provedor/modelo` do Mastra. Ainda não usado (o agente entra em fase futura).
# AGENT_MODEL=
